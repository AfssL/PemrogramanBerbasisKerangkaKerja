<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CalculatorApp.MainWindow"
        Title="Calculator"
        Width="340" Height="500"
        CanResize="False"
        Background="#1E1E1E">

  <Grid RowDefinitions="Auto,*" Margin="16">
    
    <!-- Display Screen -->
    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
      <TextBlock Text="Kalkulator" FontSize="14" Foreground="#888888" FontWeight="SemiBold"/>
      <TextBox x:Name="txtDisplay" Text="0" FontSize="32" FontWeight="Bold"
               TextAlignment="Right" IsReadOnly="True" Height="60"
               Background="#2D2D2D" Foreground="White" BorderBrush="#3D3D3D"
               CornerRadius="8" Padding="12,10"/>
    </StackPanel>

    <!-- Keypad Grid -->
    <Grid Grid.Row="1" 
          RowDefinitions="*,*,*,*,*" 
          ColumnDefinitions="*,*,*,*"
          RowSpacing="8" ColumnSpacing="8">

      <!-- Row 0: 7, 8, 9, ÷ -->
      <Button Grid.Row="0" Grid.Column="0" Content="7" Click="NumberButton_Click" Classes="num"/>
      <Button Grid.Row="0" Grid.Column="1" Content="8" Click="NumberButton_Click" Classes="num"/>
      <Button Grid.Row="0" Grid.Column="2" Content="9" Click="NumberButton_Click" Classes="num"/>
      <Button Grid.Row="0" Grid.Column="3" Content="÷" Click="OperatorButton_Click" Classes="op"/>

      <!-- Row 1: 4, 5, 6, × -->
      <Button Grid.Row="1" Grid.Column="0" Content="4" Click="NumberButton_Click" Classes="num"/>
      <Button Grid.Row="1" Grid.Column="1" Content="5" Click="NumberButton_Click" Classes="num"/>
      <Button Grid.Row="1" Grid.Column="2" Content="6" Click="NumberButton_Click" Classes="num"/>
      <Button Grid.Row="1" Grid.Column="3" Content="×" Click="OperatorButton_Click" Classes="op"/>

      <!-- Row 2: 1, 2, 3, − -->
      <Button Grid.Row="2" Grid.Column="0" Content="1" Click="NumberButton_Click" Classes="num"/>
      <Button Grid.Row="2" Grid.Column="1" Content="2" Click="NumberButton_Click" Classes="num"/>
      <Button Grid.Row="2" Grid.Column="2" Content="3" Click="NumberButton_Click" Classes="num"/>
      <Button Grid.Row="2" Grid.Column="3" Content="−" Click="OperatorButton_Click" Classes="op"/>

      <!-- Row 3: 0, ., C, + -->
      <Button Grid.Row="3" Grid.Column="0" Content="0" Click="NumberButton_Click" Classes="num"/>
      <Button Grid.Row="3" Grid.Column="1" Content="." Click="DecimalButton_Click" Classes="num"/>
      <Button Grid.Row="3" Grid.Column="2" Content="C" Click="ClearButton_Click" Classes="action"/>
      <Button Grid.Row="3" Grid.Column="3" Content="+" Click="OperatorButton_Click" Classes="op"/>

      <!-- Row 4: = (Span 4 kolom penuh ke samping) -->
      <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4"
              Content="=" Click="EqualsButton_Click" Classes="equals"/>

    </Grid>
  </Grid>

  <!-- Styling untuk Tombol agar Memenuhi Grid & Estetik -->
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    
    <!-- Tombol Angka -->
    <Style Selector="Button.num">
      <Setter Property="Background" Value="#333333"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.num:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#444444"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- Tombol Operator (+, -, ×, ÷) -->
    <Style Selector="Button.op">
      <Setter Property="Background" Value="#FF9500"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="Button.op:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#FFAA33"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- Tombol Clear (C) -->
    <Style Selector="Button.action">
      <Setter Property="Background" Value="#A5A5A5"/>
      <Setter Property="Foreground" Value="Black"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="Button.action:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#B5B5B5"/>
      <Setter Property="Foreground" Value="Black"/>
    </Style>

    <!-- Tombol Sama Dengan (=) -->
    <Style Selector="Button.equals">
      <Setter Property="Background" Value="#007ACC"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="20"/>
    </Style>
    <Style Selector="Button.equals:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1C90EE"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
  </Window.Styles>
</Window>