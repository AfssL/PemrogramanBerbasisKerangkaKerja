<Window x:Class="StudentManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Management System" Height="720" Width="1120"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Modern Biru Elegan -->
        <Border Background="#1E88E5" CornerRadius="10" Padding="20" Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect Color="#B0BEC5" BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="STUDENT MANAGEMENT SYSTEM" Foreground="White" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="Kelola Data Mahasiswa secara Cepat, Modern, &amp; Terstruktur" Foreground="#E3F2FD" FontSize="14" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Panel Kiri: Form Input & Statistik -->
            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                <!-- Card Form Mahasiswa -->
                <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,12">
                    <Border.Effect>
                        <DropShadowEffect Color="#CFD8DC" BlurRadius="8" ShadowDepth="1" Opacity="0.4"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Form Data Mahasiswa" FontSize="16" FontWeight="Bold" Foreground="#37474F" Margin="0,0,0,12"/>
                        
                        <TextBlock Text="NIM" Foreground="#546E7A" FontWeight="SemiBold" FontSize="12"/>
                        <TextBox Text="{Binding SelectedStudent.NIM, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" Padding="5,0" Margin="0,4,0,10" Background="White" Foreground="Black"/>

                        <TextBlock Text="Nama Lengkap" Foreground="#546E7A" FontWeight="SemiBold" FontSize="12"/>
                        <TextBox Text="{Binding SelectedStudent.Nama, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" Padding="5,0" Margin="0,4,0,10" Background="White" Foreground="Black"/>

                        <TextBlock Text="Jurusan" Foreground="#546E7A" FontWeight="SemiBold" FontSize="12"/>
                        <ComboBox SelectedItem="{Binding SelectedStudent.Jurusan}" Height="32" VerticalContentAlignment="Center" Margin="0,4,0,10">
                            <ComboBoxItem>Informatika</ComboBoxItem>
                            <ComboBoxItem>Sistem Informasi</ComboBoxItem>
                            <ComboBoxItem>Teknik Komputer</ComboBoxItem>
                        </ComboBox>

                        <TextBlock Text="Gender" Foreground="#546E7A" FontWeight="SemiBold" FontSize="12"/>
                        <ComboBox SelectedItem="{Binding SelectedStudent.Gender}" Height="32" VerticalContentAlignment="Center" Margin="0,4,0,10">
                            <ComboBoxItem>Laki-laki</ComboBoxItem>
                            <ComboBoxItem>Perempuan</ComboBoxItem>
                        </ComboBox>

                        <TextBlock Text="Email" Foreground="#546E7A" FontWeight="SemiBold" FontSize="12"/>
                        <TextBox Text="{Binding SelectedStudent.Email, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" Padding="5,0" Margin="0,4,0,15" Background="White" Foreground="Black"/>

                        <!-- Action Buttons dengan Warna Kontras & Elegan -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Simpan" Command="{Binding SaveCommand}" Background="#2E7D32" Foreground="White" FontWeight="Bold" Height="36" Margin="0,0,4,0" Cursor="Hand"/>
                            <Button Grid.Column="1" Content="Hapus" Command="{Binding DeleteCommand}" Background="#C62828" Foreground="White" FontWeight="Bold" Height="36" Margin="4,0,0,0" Cursor="Hand"/>
                        </Grid>
                        <Button Content="Reset Form" Command="{Binding ResetCommand}" Background="#B0BEC5" Foreground="#263238" FontWeight="SemiBold" Height="32" Margin="0,8,0,0" Cursor="Hand"/>
                    </StackPanel>
                </Border>

                <!-- Card Statistik Ringkas -->
                <Border Background="White" CornerRadius="8" Padding="15">
                    <Border.Effect>
                        <DropShadowEffect Color="#CFD8DC" BlurRadius="8" ShadowDepth="1" Opacity="0.4"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Statistik Sistem" FontSize="16" FontWeight="Bold" Foreground="#37474F" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding TotalStudents, StringFormat='Total Mahasiswa: {0}'}" FontSize="13" Foreground="#455A64" Margin="0,3"/>
                        <TextBlock Text="{Binding TotalInformatika, StringFormat='Informatika: {0}'}" FontSize="13" Foreground="#455A64" Margin="0,3"/>
                        <TextBlock Text="{Binding TotalSistemInformasi, StringFormat='Sistem Informasi: {0}'}" FontSize="13" Foreground="#455A64" Margin="0,3"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Panel Kanan: Pencarian & Tabel DataGrid -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search Bar Container -->
                <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                    <Border.Effect>
                        <DropShadowEffect Color="#CFD8DC" BlurRadius="8" ShadowDepth="1" Opacity="0.4"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="320" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,10,0" Background="White" Foreground="Black"/>
                        <Button Content="Cari Mahasiswa" Command="{Binding SearchCommand}" Width="120" Height="34" Background="#1E88E5" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                    </StackPanel>
                </Border>

                <!-- DataGrid Tabel dengan Styling Bersih -->
                <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="5">
                    <Border.Effect>
                        <DropShadowEffect Color="#CFD8DC" BlurRadius="8" ShadowDepth="1" Opacity="0.4"/>
                    </Border.Effect>
                    <DataGrid ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" 
                              Background="White" BorderBrush="#ECEFF1" RowHeight="32" 
                              AlternatingRowBackground="#FAFAFA" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEEEEE">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NIM" Binding="{Binding NIM}" Width="100"/>
                            <DataGridTextColumn Header="Nama Lengkap" Binding="{Binding Nama}" Width="170"/>
                            <DataGridTextColumn Header="Jurusan" Binding="{Binding Jurusan}" Width="150"/>
                            <DataGridTextColumn Header="Gender" Binding="{Binding Gender}" Width="90"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>