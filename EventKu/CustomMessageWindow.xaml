<Window x:Class="EventKu.CustomMessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Informasi" Height="180" Width="360"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="White" WindowStyle="ToolWindow">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Pesan Informasi -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="ℹ️" FontSize="26" VerticalAlignment="Center" Margin="0,0,15,0"/>
            <TextBlock x:Name="txtMessage" Text="Pesan informasi" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="240"/>
        </StackPanel>

        <!-- Tombol OK -->
        <Button Grid.Row="1" Content="OK" Click="BtnOk_Click" 
                Background="#00529B" Foreground="White" FontWeight="Bold" 
                Width="80" Height="30" HorizontalAlignment="Center" 
                Cursor="Hand" BorderThickness="0"/>
    </Grid>
</Window>