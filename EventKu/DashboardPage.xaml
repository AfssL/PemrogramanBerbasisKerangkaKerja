<Page x:Class="EventKu.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="DashboardPage" Background="#F8FAFC">

    <Page.Resources>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="35,25,35,35">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="📊 Dashboard Manajemen Agenda" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Pusat kontrol terpadu untuk mengelola jadwal seminar, workshop, dan kompetisi kampus." FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Kartu Statistik -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#E0F2FE" CornerRadius="12" Padding="20" Margin="0,0,10,0">
                    <Border.Effect><DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="1" Color="#BAE6FD" Opacity="0.5"/></Border.Effect>
                    <StackPanel>
                        <TextBlock Text="TOTAL AGENDA" FontSize="11" FontWeight="Bold" Foreground="#0369A1"/>
                        <TextBlock x:Name="txtTotalEvent" Text="0" FontSize="30" FontWeight="Bold" Foreground="#0C4A6E" Margin="0,4,0,0"/>
                        <TextBlock Text="Keseluruhan event terdaftar" FontSize="11" Foreground="#0284C7" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#E0F2FE" CornerRadius="12" Padding="20" Margin="5,0,5,0">
                    <Border.Effect><DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="1" Color="#BAE6FD" Opacity="0.5"/></Border.Effect>
                    <StackPanel>
                        <TextBlock Text="AGENDA MENDATANG" FontSize="11" FontWeight="Bold" Foreground="#0284C7"/>
                        <TextBlock x:Name="txtUpcomingEvent" Text="0" FontSize="30" FontWeight="Bold" Foreground="#0C4A6E" Margin="0,4,0,0"/>
                        <TextBlock Text="Status: Upcoming / Ongoing" FontSize="11" Foreground="#0369A1" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#F1F5F9" CornerRadius="12" Padding="20" Margin="10,0,0,0">
                    <Border.Effect><DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="1" Color="#E2E8F0" Opacity="0.5"/></Border.Effect>
                    <StackPanel>
                        <TextBlock Text="AGENDA SELESAI" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                        <TextBlock x:Name="txtCompletedEvent" Text="0" FontSize="30" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                        <TextBlock Text="Status: Completed (Arsip)" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Form Input Terstruktur -->
            <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="22" Margin="0,0,0,20">
                <Border.Effect><DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="1" Color="#E2E8F0" Opacity="0.6"/></Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,15,14">
                        <TextBlock Text="Nama Event" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtTitle" Height="32" Padding="6" Background="White" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,15,14">
                        <TextBlock Text="Kategori" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cbCategory" Height="32" Padding="4">
                            <ComboBoxItem Content="Seminar"/>
                            <ComboBoxItem Content="Workshop"/>
                            <ComboBoxItem Content="Lomba / Kompetisi"/>
                            <ComboBoxItem Content="Organisasi"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,15,14">
                        <TextBlock Text="Tanggal &amp; Waktu" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtDate" Height="32" Padding="6" Background="White" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1"/>
                    </StackPanel>

                    <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,15,0">
                        <TextBlock Text="Lokasi / Link" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtLocation" Height="32" Padding="6" Background="White" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Grid.Row="1" Margin="0,0,15,0">
                        <TextBlock Text="Status" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cbStatus" Height="32" Padding="4">
                            <ComboBoxItem Content="Upcoming"/>
                            <ComboBoxItem Content="Ongoing"/>
                            <ComboBoxItem Content="Completed"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Tombol Aksi -->
                    <StackPanel Grid.Column="3" Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                        <Border CornerRadius="6" Background="#00529B" Margin="0,0,8,0">
                            <Button Content="➕ Tambah" Click="BtnAdd_Click" Background="Transparent" Foreground="White" FontWeight="Bold" Padding="14,8" BorderThickness="0" Cursor="Hand"/>
                        </Border>
                        <Border CornerRadius="6" Background="#0284C7" Margin="0,0,8,0">
                            <Button Content="✏️ Update" Click="BtnUpdate_Click" Background="Transparent" Foreground="White" FontWeight="Bold" Padding="14,8" BorderThickness="0" Cursor="Hand"/>
                        </Border>
                        <Border CornerRadius="6" Background="#EF4444">
                            <Button Content="🗑️ Hapus" Click="BtnDelete_Click" Background="Transparent" Foreground="White" FontWeight="Bold" Padding="14,8" BorderThickness="0" Cursor="Hand"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- DataGrid Rapi -->
            <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="15">
                <Border.Effect><DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="1" Color="#E2E8F0" Opacity="0.6"/></Border.Effect>
                <DataGrid x:Name="dgEvents" AutoGenerateColumns="False" CanUserAddRows="False" 
                          Background="White" Foreground="#0F172A" BorderBrush="#E2E8F0" 
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" 
                          RowHeight="38" SelectionChanged="DgEvents_SelectionChanged">
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="#0F172A"/>
                            <Setter Property="Padding" Value="8,0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                        <DataGridTextColumn Header="Nama Event" Binding="{Binding Title}" Width="*"/>
                        <DataGridTextColumn Header="Kategori" Binding="{Binding Category}" Width="140"/>
                        <DataGridTextColumn Header="Tanggal" Binding="{Binding EventDate}" Width="150"/>
                        <DataGridTextColumn Header="Lokasi" Binding="{Binding Location}" Width="160"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>