<Window x:Class="EventKu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EventKu - Sistem Informasi Agenda &amp; Event Kampus" Height="720" Width="1200"
        WindowStartupLocation="CenterScreen" Background="#F0F4F8">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Profesional -->
        <Border Grid.Column="0" Background="#0F2027">
            <StackPanel Margin="20">
                <!-- Logo & Judul -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                    <TextBlock Text="🎓" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="EventKu" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="MENU UTAMA" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,10"/>

                <!-- Tombol Navigasi Menu -->
                <Border CornerRadius="8" Background="#00529B" Margin="0,0,0,6">
                    <Button x:Name="BtnDashboard" Content="📊 Dashboard Agenda" Click="NavigateDashboard" Background="Transparent" Foreground="White" FontWeight="SemiBold" HorizontalContentAlignment="Left" Padding="12,10" BorderThickness="0" Cursor="Hand"/>
                </Border>

                <Border CornerRadius="8" Background="Transparent" Margin="0,0,0,6">
                    <Button x:Name="BtnCategory" Content="🏷️ Kategori Event" Click="NavigateCategory" Background="Transparent" Foreground="#94A3B8" FontWeight="SemiBold" HorizontalContentAlignment="Left" Padding="12,10" BorderThickness="0" Cursor="Hand"/>
                </Border>

                <Border CornerRadius="8" Background="Transparent" Margin="0,0,0,6">
                    <Button x:Name="BtnReviews" Content="💬 Ulasan Kegiatan" Click="NavigateReviews" Background="Transparent" Foreground="#94A3B8" FontWeight="SemiBold" HorizontalContentAlignment="Left" Padding="12,10" BorderThickness="0" Cursor="Hand"/>
                </Border>

                <Border CornerRadius="8" Background="Transparent" Margin="0,0,0,6">
                    <Button x:Name="BtnArchive" Content="📁 Arsip Selesai" Click="NavigateArchive" Background="Transparent" Foreground="#94A3B8" FontWeight="SemiBold" HorizontalContentAlignment="Left" Padding="12,10" BorderThickness="0" Cursor="Hand"/>
                </Border>

                <Border CornerRadius="8" Background="Transparent">
                    <Button x:Name="BtnSettings" Content="⚙️ Pengaturan Aplikasi" Click="NavigateSettings" Background="Transparent" Foreground="#94A3B8" FontWeight="SemiBold" HorizontalContentAlignment="Left" Padding="12,10" BorderThickness="0" Cursor="Hand"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Main Frame View -->
        <Frame x:Name="MainFrame" Grid.Column="1" Source="DashboardPage.xaml" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>