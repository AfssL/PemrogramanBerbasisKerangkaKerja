<Page x:Class="EventKu.ArchivePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="ArchivePage" Background="#F8FAFC">
    <Grid Margin="35,25,35,35">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="📁 Arsip Agenda Selesai" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,5"/>
            <TextBlock Text="Dokumentasi riwayat event kampus yang telah sukses dilaksanakan dan berstatus Completed." FontSize="13" Foreground="#64748B"/>
        </StackPanel>

        <!-- DataGrid Arsip Bebas Blok Hitam -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="15">
            <Border.Effect><DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="1" Color="#E2E8F0" Opacity="0.6"/></Border.Effect>
            <DataGrid x:Name="dgArchive" AutoGenerateColumns="False" CanUserAddRows="False" 
                      Background="White" Foreground="#0F172A" BorderBrush="#E2E8F0" 
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" RowHeight="38">
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Foreground" Value="#0F172A"/>
                        <Setter Property="Padding" Value="8,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <!-- Mencegah blok hitam saat baris dipilih -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#E0F2FE"/>
                                <Setter Property="Foreground" Value="#0C4A6E"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                    <DataGridTextColumn Header="Nama Event" Binding="{Binding Title}" Width="*"/>
                    <DataGridTextColumn Header="Kategori" Binding="{Binding Category}" Width="140"/>
                    <DataGridTextColumn Header="Tanggal" Binding="{Binding EventDate}" Width="150"/>
                    <DataGridTextColumn Header="Lokasi" Binding="{Binding Location}" Width="160"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>