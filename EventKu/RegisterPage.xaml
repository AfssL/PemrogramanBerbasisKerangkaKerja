<Window x:Class="EventKu.Views.RegisterPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EventKu - Register" Height="500" Width="360" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F4F6F9">
    <Grid Margin="25">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="DAFTAR AKUN BARU" FontSize="20" FontWeight="Bold" Foreground="#333333" HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <TextBlock Text="Nama Lengkap" FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,3"/>
            <TextBox x:Name="txtFullName" Height="30" Padding="5" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

            <TextBlock Text="Username" FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,3"/>
            <TextBox x:Name="txtUsername" Height="30" Padding="5" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

            <TextBlock Text="Email" FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,3"/>
            <TextBox x:Name="txtEmail" Height="30" Padding="5" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

            <TextBlock Text="Password" FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,3"/>
            <PasswordBox x:Name="txtPassword" Height="30" Padding="5" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

            <Button Content="Register" Height="40" Background="#28A745" Foreground="White" FontWeight="Bold" BorderBrush="{x:Null}" Cursor="Hand" Click="BtnRegister_Click" Margin="0,0,0,10"/>
            <Button Content="Sudah punya akun? Login" Height="30" Background="Transparent" BorderBrush="{x:Null}" Foreground="#007ACC" Cursor="Hand" Click="BtnToLogin_Click"/>
        </StackPanel>
    </Grid>
</Window>